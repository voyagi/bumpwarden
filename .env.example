# Copy to .env for local runs. Never commit .env.
# Node does not let this file override a variable that is already set in your environment,
# so a machine-level GEMINI_API_KEY or GITHUB_TOKEN wins over the value written here.
NODE_ENV=development
# Local runs stay on loopback. The container image sets HOST to all interfaces because Cloud Run routes traffic into it.
HOST=127.0.0.1
PORT=8080
# Gemini API key from Google AI Studio (free tier is enough).
GEMINI_API_KEY=
# Fine-grained GitHub token scoped to the watched repositories (issues, pull requests, contents).
GITHUB_TOKEN=
# Google Cloud project that hosts Firestore, Cloud Run and Cloud Scheduler.
GOOGLE_CLOUD_PROJECT=
# Point at the Firestore emulator for local development and tests. Start it with
# `npm run emulator`, which serves it on 8081 so it does not collide with the app on 8080.
# Uncomment only while the emulator is running. Left set with nothing listening, every
# Firestore call fails instead of reaching the real database.
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8081
# Service account email that Cloud Scheduler uses to sign the OIDC token for the run endpoint.
RUN_INVOKER_EMAIL=
# Public base URL of the deployed service (used in links inside issues and pull requests, and
# as the OIDC audience for the run endpoint). Not named BASE_URL: Vite and Vitest inject a
# BASE_URL of "/" into the process environment, which would fail validation on every test run.
SERVICE_BASE_URL=http://127.0.0.1:8080
# owner/repo of the demo project that visitors may trigger with "Run now".
DEMO_REPO=voyagi/bumpwarden-demo-app
