{
  "minTokens": 70,
  "minLines": 8,
  "threshold": 0,
  "reporters": ["console-full"],
  "ignore": [
    "**/.git/**",
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/coverage/**",
    "**/playwright-report/**",
    "**/*.test.*",
    "**/*.spec.*",
    "**/*.d.ts",
    "**/*.md",
    "**/docs/**",
    "**/design/**",
    "**/public/fonts/**",
    "**/package-lock.json"
  ]
}
